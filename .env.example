DATABASE_URL=postgresql://powermesh:powermesh@localhost:5432/powermesh
API_HOST=127.0.0.1
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
AGENT_NODE_NAME=local-provider
POWERMESH_COORDINATOR_KEY=local-only-change-me
POWERMESH_ENROLLMENT_KEY=local-enrollment-change-me
OFFER_SIGNING_PRIVATE_KEY_BASE64=
POWERMESH_IMAGE_TRANSFORM_IMAGE=
POWERMESH_GPU_BENCHMARK_IMAGE=
POWERMESH_COORDINATOR_URL=http://localhost:4000
POWERMESH_OWNER_ID=
POWERMESH_NODE_ID=
POWERMESH_EXPECTED_KEY_FINGERPRINT=
POWERMESH_AGENT_VERSION=0.1.0
POWERMESH_EGRESS_PROXY_IMAGE=
POWERMESH_AUTO_APPROVE_LOW_RISK=false
# Windows GPU demo: run the Agent inside WSL2 with Docker Desktop's WSL backend.
# This explicitly enables a development runtime and does not claim rootless isolation.
POWERMESH_ALLOW_DESKTOP_SANDBOX=false
# WSL2 can store Agent credentials through the current Windows user's DPAPI vault.
POWERMESH_CREDENTIAL_STORE=system

# ── Web app (apps/web) ────────────────────────────────────────────────
# "offline-demo" = in-app simulator for rehearsal, no backend needed ("mock" still works as an alias).
# "live" = job screens use the API above through the web server's bridge; the enrollment key stays
# server-side and never reaches the browser.
NEXT_PUBLIC_POWERMESH_MODE=live
# The offline demo (simulator, demo controls, role switcher) is off in production builds (Q30). Set to 1 only
# for a rehearsal build.
NEXT_PUBLIC_POWERMESH_OFFLINE_DEMO=0
# Coordinator URL as seen from the web server. Falls back to NEXT_PUBLIC_API_URL.
POWERMESH_API_URL=http://127.0.0.1:4000
POWERMESH_COMMUNITY_ID=local-dev

# ── Sponsor integrations ─────────────────────────────────────────────────
# Gemini explains risk decisions on the coordinator. It never decides: tiers come from the policy engine.
# Leave the key empty (or AI_FEATURES_ENABLED=false) to use rule-based explanations; nothing breaks offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=8000
AI_FEATURES_ENABLED=true
# Tiger Data: point DATABASE_URL at a Tiger Cloud service (sslmode=require), then run `pnpm --filter @powermesh/api db:migrate`.
