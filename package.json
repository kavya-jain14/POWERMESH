{
  "name": "powermesh",
  "version": "0.1.0",
  "private": true,
  "description": "PowerMesh — share a capability, not a device.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "build:web": "pnpm --filter @powermesh/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:contrast": "node packages/ui/scripts/check-contrast.mjs",
    "db:migrate": "pnpm --filter @powermesh/api db:migrate",
    "dev": "turbo dev --parallel",
    "dev:api": "pnpm --filter @powermesh/api dev",
    "dev:web": "pnpm --filter @powermesh/web dev",
    "format": "biome check --write .",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres",
    "workload:image:build": "docker build --file Dockerfile.workload-image-transform --tag powermesh/image-transform:1.0.0 .",
    "workload:gpu:build": "docker build --file Dockerfile.workload-gpu-benchmark --tag powermesh/gpu-benchmark:1.0.0 .",
    "lint": "biome check .",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
